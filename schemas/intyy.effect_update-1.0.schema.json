{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "intyy.effect_update/1.0"
    },
    "parent_run_id": {
      "type": "string",
      "pattern": "^run_\\d{4}-\\d{2}-\\d{2}_[0-9a-hjkmnp-tv-z]{10}$"
    },
    "check_run_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^run_\\d{4}-\\d{2}-\\d{2}_[0-9a-hjkmnp-tv-z]{10}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "finding": {
      "type": "string",
      "enum": [
        "found_by_check",
        "absent_by_check"
      ]
    },
    "decided_by": {
      "type": "string",
      "enum": [
        "code",
        "human"
      ]
    },
    "staff_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    }
  },
  "required": [
    "schema",
    "parent_run_id",
    "check_run_id",
    "finding",
    "decided_by",
    "staff_id",
    "at"
  ],
  "additionalProperties": false
}
