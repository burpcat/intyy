{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "intyy.intervention/1.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run_\\d{4}-\\d{2}-\\d{2}_[0-9a-hjkmnp-tv-z]{10}$"
    },
    "tenant": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "capability": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "approval",
        "takeover",
        "start_confirmation"
      ]
    },
    "reason": {
      "type": "string",
      "enum": [
        "discovery_irreversible",
        "stuck",
        "no_authorization",
        "supervised_mode"
      ]
    },
    "step": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "intent": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "intent"
      ],
      "additionalProperties": false
    },
    "trouble": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "phase": {
              "type": "string"
            },
            "detail": {
              "type": "string"
            }
          },
          "required": [
            "phase",
            "detail"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "ladder": {
      "type": "array",
      "items": {}
    },
    "commit": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string"
        }
      },
      "required": [
        "state"
      ],
      "additionalProperties": false
    },
    "operator_note": {
      "type": [
        "string",
        "null"
      ]
    },
    "approval": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "words": {
              "type": [
                "string",
                "null"
              ]
            },
            "risk": {
              "type": "string",
              "const": "irreversible"
            },
            "authorization": {
              "type": "string"
            }
          },
          "required": [
            "words",
            "risk",
            "authorization"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "screenshot": {
      "type": [
        "string",
        "null"
      ]
    },
    "decisions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "outcomes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deadline": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "lease": {
      "type": [
        "string",
        "null"
      ]
    },
    "on_handback": {
      "type": [
        "string",
        "null"
      ]
    },
    "opened_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    }
  },
  "required": [
    "schema",
    "run_id",
    "tenant",
    "capability",
    "kind",
    "reason",
    "step",
    "trouble",
    "ladder",
    "commit",
    "operator_note",
    "approval",
    "screenshot",
    "decisions",
    "outcomes",
    "deadline",
    "lease",
    "on_handback",
    "opened_at"
  ],
  "additionalProperties": false
}
