{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "intyy.suite/1.0"
    },
    "capability": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*\\/[a-z][a-z0-9_]*@\\d+$"
    },
    "revision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "classes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "inputs": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            }
          },
          "expect": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "status"
            ],
            "additionalProperties": {}
          }
        },
        "required": [
          "id",
          "inputs",
          "expect"
        ],
        "additionalProperties": false
      }
    },
    "matrix": {
      "type": "object",
      "properties": {
        "class": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "profiles": {
          "anyOf": [
            {
              "type": "string",
              "const": "standard"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        }
      },
      "required": [
        "class",
        "profiles"
      ],
      "additionalProperties": false
    },
    "stability": {
      "type": "object",
      "properties": {
        "class": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "levels": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "seeds": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "twins": {
          "type": "boolean"
        }
      },
      "required": [
        "class",
        "levels",
        "seeds",
        "twins"
      ],
      "additionalProperties": false
    },
    "drills": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "count"
      ],
      "additionalProperties": false
    },
    "extra": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "class": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "faults": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "session_expire",
                    "known_popup",
                    "unknown_popup",
                    "supervisor_required",
                    "server_error",
                    "maintenance",
                    "drop_after_confirm"
                  ]
                },
                "at": {
                  "anyOf": [
                    {
                      "type": "string",
                      "const": "@commit_point"
                    },
                    {
                      "type": "string",
                      "const": "@each_request_step"
                    },
                    {
                      "type": "string",
                      "pattern": "^@step:[a-z][a-z0-9_]*$"
                    }
                  ]
                },
                "which": {
                  "type": "string",
                  "const": "first"
                }
              },
              "required": [
                "kind",
                "at"
              ],
              "additionalProperties": false
            }
          },
          "expect": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "status"
            ],
            "additionalProperties": {}
          }
        },
        "required": [
          "id",
          "class",
          "faults",
          "expect"
        ],
        "additionalProperties": false
      }
    },
    "setup": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "capability": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*\\/[a-z][a-z0-9_]*@\\d+$"
          },
          "class": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "required": [
          "capability",
          "class"
        ],
        "additionalProperties": false
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "runs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "run_id": {
                "type": "string",
                "pattern": "^run_\\d{4}-\\d{2}-\\d{2}_[0-9a-hjkmnp-tv-z]{10}$"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "discovery",
                  "negative_discovery",
                  "replay",
                  "certify"
                ]
              }
            },
            "required": [
              "run_id",
              "kind"
            ],
            "additionalProperties": false
          }
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "what": {
                "type": "string",
                "enum": [
                  "risk",
                  "sensitivity",
                  "outcome_name",
                  "waiver",
                  "refusal",
                  "edit",
                  "patch",
                  "risk_second_look"
                ]
              },
              "subject": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "string",
                "minLength": 1
              },
              "by": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              }
            },
            "required": [
              "what",
              "subject",
              "value",
              "by",
              "at"
            ],
            "additionalProperties": false
          }
        },
        "sealed": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "by": {
                  "type": "string",
                  "minLength": 1
                },
                "at": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                }
              },
              "required": [
                "by",
                "at"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "runs",
        "decisions",
        "sealed"
      ],
      "additionalProperties": false
    },
    "approved": {
      "type": "object",
      "properties": {
        "by": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        }
      },
      "required": [
        "by",
        "at"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "capability",
    "revision",
    "reason",
    "classes",
    "matrix",
    "stability",
    "drills",
    "extra",
    "setup",
    "provenance"
  ],
  "additionalProperties": false
}
