{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "intyy.request/1.0"
    },
    "request_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "capability": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*\\/[a-z][a-z0-9_]*@[1-9]\\d*$"
    },
    "inputs": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      }
    },
    "mode": {
      "type": "string",
      "enum": [
        "supervised",
        "unattended"
      ]
    },
    "authorization": {
      "type": "object",
      "properties": {
        "consent_ref": {
          "type": "string",
          "minLength": 1
        },
        "granted_by": {
          "type": "string",
          "enum": [
            "member",
            "staff"
          ]
        },
        "staff_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "granted_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "capability": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*\\/[a-z][a-z0-9_]*@[1-9]\\d*$"
        }
      },
      "required": [
        "consent_ref",
        "granted_by",
        "granted_at",
        "expires_at",
        "capability"
      ],
      "additionalProperties": false
    },
    "wait_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 120000
    }
  },
  "required": [
    "schema",
    "request_id",
    "capability",
    "inputs",
    "mode"
  ],
  "additionalProperties": false
}
