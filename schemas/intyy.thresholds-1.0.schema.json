{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "intyy.thresholds/1.0"
    },
    "app": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "jev_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_@+-][A-Za-z0-9_.@+-]*$"
    },
    "revision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "handler_min": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "outcome_min": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reconciliation_min": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "approved": {
      "type": "object",
      "properties": {
        "by": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        }
      },
      "required": [
        "by",
        "at"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "app",
    "jev_version",
    "revision",
    "handler_min",
    "outcome_min",
    "reconciliation_min"
  ],
  "additionalProperties": false
}
