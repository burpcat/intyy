{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "intyy.patch/1.0"
    },
    "tenant": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "base": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*\\/[a-z][a-z0-9_]*@[1-9]\\d*$"
    },
    "revision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "targets": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "clues": {
            "type": "object",
            "properties": {
              "role": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "name": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "label": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "text": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "region": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "number"
                      },
                      "y": {
                        "type": "number"
                      },
                      "w": {
                        "type": "number"
                      },
                      "h": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "x",
                      "y",
                      "w",
                      "h"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "image": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "path": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "additionalProperties": false
          },
          "within": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "conditions": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string",
            "minLength": 1
          },
          "match": {
            "type": "string",
            "enum": [
              "exact",
              "contains",
              "wildcard"
            ]
          },
          "pattern": {
            "type": "string",
            "pattern": "^\\/\\S*$"
          },
          "op": {
            "type": "string",
            "enum": [
              "equals",
              "at_least",
              "at_most"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "runs": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "run_id": {
                "type": "string",
                "pattern": "^run_\\d{4}-\\d{2}-\\d{2}_[0-9a-hjkmnp-tv-z]{10}$"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "discovery",
                  "negative_discovery",
                  "replay",
                  "certify"
                ]
              }
            },
            "required": [
              "run_id",
              "kind"
            ],
            "additionalProperties": false
          }
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "what": {
                "type": "string",
                "enum": [
                  "risk",
                  "sensitivity",
                  "outcome_name",
                  "waiver",
                  "refusal",
                  "edit",
                  "patch",
                  "risk_second_look"
                ]
              },
              "subject": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "string",
                "minLength": 1
              },
              "by": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              }
            },
            "required": [
              "what",
              "subject",
              "value",
              "by",
              "at"
            ],
            "additionalProperties": false
          }
        },
        "sealed": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "by": {
                  "type": "string",
                  "minLength": 1
                },
                "at": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                }
              },
              "required": [
                "by",
                "at"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "runs",
        "decisions",
        "sealed"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "tenant",
    "base",
    "revision",
    "reason",
    "provenance"
  ],
  "additionalProperties": false
}
