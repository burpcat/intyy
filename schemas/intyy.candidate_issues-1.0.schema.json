{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "intyy.candidate_issues/1.0"
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "level": {
            "type": "string",
            "enum": [
              "blocking",
              "warning"
            ]
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "subject": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "level",
          "code",
          "message"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "issues"
  ],
  "additionalProperties": false
}
