{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "intyy.staff/1.0"
    },
    "staff": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "roles": {
            "type": "object",
            "propertyNames": {
              "anyOf": [
                {
                  "type": "string",
                  "const": "*"
                },
                {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]*$"
                }
              ]
            },
            "additionalProperties": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "operator",
                  "reviewer",
                  "approver"
                ]
              }
            }
          }
        },
        "required": [
          "id",
          "roles"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "staff"
  ],
  "additionalProperties": false
}
