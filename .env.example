# intyy environment variables.
# Copy this file to .env, then fill in the values.
# .env is git-ignored. Never commit real values.
# intyy loads .env at start. It never overrides a variable already set in your shell.

# ---------------------------------------------------------------------------
# Model keys. intyy.json "model_keys" names these variables.
# ---------------------------------------------------------------------------

# Claude: discovery (from M03) and the reviewer on rung 3 (from M09).
ANTHROPIC_API_KEY=

# jev: the error sorter on rung 2 (from M09). Leave empty until then.
TYPESAFE_API_KEY=

# ---------------------------------------------------------------------------
# Who you are. A staff ID from library/staff.json: op_017, op_022, or op_031.
# Needed by every command that writes. Not a secret.
# ---------------------------------------------------------------------------

INTYY_STAFF=op_017

# ---------------------------------------------------------------------------
# Bank credentials for tenant "keystone", app "kvfcu".
# Name pattern: INTYY_<TENANT>_<APP>_<NAME> (design section 4 §8.3).
# library/settings/keystone/1.json binds them to the secret names
# operator_username and operator_password.
# Use the bank app's TELLER user. It is set in the bank app's own .env
# as KVFCU_TELLER_USER and KVFCU_TELLER_PASS (CONTRACT §3).
# ---------------------------------------------------------------------------

INTYY_KEYSTONE_KVFCU_OPERATOR_USERNAME=
INTYY_KEYSTONE_KVFCU_OPERATOR_PASSWORD=

# ---------------------------------------------------------------------------
# intyy's own key for the request index (design section 4 §8.11).
# 64 hex characters. Make it once:  openssl rand -hex 32
# ---------------------------------------------------------------------------

INTYY_KEYSTONE_REQUEST_INDEX_KEY_K1=

# ---------------------------------------------------------------------------
# The restricted user (evidence item A10). Do NOT put these values here.
# Create a second file, .env.restricted, with the same two names:
#
#   INTYY_KEYSTONE_KVFCU_OPERATOR_USERNAME=<the restricted user>
#   INTYY_KEYSTONE_KVFCU_OPERATOR_PASSWORD=<its password>
#
# Then run the replay in a subshell, so no value reaches the command line:
#
#   (set -a; . ./.env.restricted; set +a; intyy replay kvfcu/open_share_subaccount@1 \
#      --mode supervised --inputs demo/valid.json)
#
# Supervisor credentials are never stored. A human types them during a takeover.
# ---------------------------------------------------------------------------
