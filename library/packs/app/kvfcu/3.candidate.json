        "no_fire": [
          "normal_login",
          "normal_lastlogin"
        ]
      },
      "class": "recoverable",
      "response": [
        {
          "type": "sign_in",
          "risk": "idempotent"
        }
      ],
      "limits": {
        "per_step": 1,
        "per_run": 2
      },
      "on_exhausted": {
        "class": "hard_failure",
        "failure": "app_error"
      }
    },
    {
