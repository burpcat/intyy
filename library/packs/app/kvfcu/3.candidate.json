          "risk": "idempotent"
        }
      ],
      "limits": {
        "per_step": 2,
        "per_run": 3
      },
      "on_exhausted": {
        "class": "hard_failure",
        "failure": "app_error"
      }
    },
    {
      "id": "blank_page",
      "description": "The app returned an empty page.",
      "detector": "page_blank",
      "fixtures": {
