{
  "schema": "intyy.policy/1.0",
  "revision": 1,
  "reason": "kvfcu sign-in: the operator secrets on the sign-in page, the last-login notice and its Continue button, and the main page. Test endpoints denied.",
  "scope": {
    "level": "app",
    "app": "kvfcu"
  },
  "paths": {
    "allow": [
      "/",
      "/login.do",
      "/lastLogin.do",
      "/main.do"
    ],
    "deny": [
      "/__test__/*"
    ],
    "irreversible": []
  },
  "risk": {
    "safe_words": [
      "continue"
    ]
  },
  "secrets": {
    "operator_username": {
      "kind": "username",
      "paths": [
        "/login.do"
      ]
    },
    "operator_password": {
      "kind": "password",
      "paths": [
        "/login.do"
      ]
    }
  },
  "approved": {
    "by": "op_031",
    "at": "2026-09-29T00:34:21.825Z"
  }
}
