        "name": "member_id",
        "type": "string",
        "description": "The member number of the account holder",
        "required": true,
        "sensitivity": "pii",
        "constraints": {
          "length": {
            "min": 6,
            "max": 6
          },
          "format": "digits"
        }
      },
      {
        "name": "deposit",
        "type": "money",
        "description": "The opening deposit for the new sub-account",
        "required": true,
        "sensitivity": "financial",
        "constraints": {
          "range": {
            "min": "0.01"
          }
        }
      }
    ],
    "outputs": [
      {
        "name": "account_number",
        "type": "string",
        "description": "The account number of the new share sub-account",
        "sensitivity": "pii"
      }
    ],
